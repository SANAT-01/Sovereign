# Root-level env vars used by docker-compose.yml / docker-compose.prod.yml.
# Copy to .env and fill in real values — .env is git-ignored.

# AIStor/MinIO license (free tier) — activates the software, does NOT grant
# registry pull access. See APPROACH.md §8.
MINIO_LICENSE=

# Only required for docker-compose.prod.yml — the dev compose file hardcodes
# throwaway local credentials instead.
POSTGRES_PASSWORD=
MINIO_ROOT_USER=
MINIO_ROOT_PASSWORD=
