# Server
PORT=4000
NODE_ENV=development

# Frontend origin — Google's OAuth redirect lands on this server directly,
# so post-login redirects must point back to the frontend explicitly.
FRONTEND_URL=http://localhost:3000

# Postgres (matches docker-compose.yml local db: user/pass/db = app/app/multi_purpose)
DATABASE_URL=postgres://app:app@localhost:5432/multi_purpose

# Session
# Generate a real random value for actual use, e.g.: openssl rand -base64 48
SESSION_SECRET=replace-with-a-long-random-string

# Google OAuth (create credentials in Google Cloud Console; see oauth-setup skill)
# Authorized redirect URI for local dev: http://localhost:4000/auth/google/callback
GOOGLE_CLIENT_ID=replace-with-google-client-id
GOOGLE_CLIENT_SECRET=replace-with-google-client-secret

# MinIO (self-hosted object storage, matches docker-compose.yml; see APPROACH.md §8)
MINIO_ENDPOINT=localhost
MINIO_PORT=9000
MINIO_USE_SSL=false
MINIO_ACCESS_KEY=app
MINIO_SECRET_KEY=apppassword
MINIO_BUCKET=multi-purpose-uploads
# Public URL the browser loads uploaded files from — local dev only;
# production needs its own exposed route (see §8's last bullet).
MINIO_PUBLIC_URL=http://localhost:9000
