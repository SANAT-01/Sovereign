# Server
PORT=4000
NODE_ENV=development

# Frontend origin — used to build the absolute Google OAuth callbackURL
# (see auth/google.ts) and for post-login redirects. Google redirects the
# browser here, not to this server directly; Next's rewrite then proxies
# /auth/* back to this API (APPROACH.md §6).
FRONTEND_URL=http://localhost:3000

# Postgres (matches docker-compose.yml local db: user/pass/db = app/app/multi_purpose)
DATABASE_URL=postgres://app:app@localhost:5432/multi_purpose

# Session
# Generate a real random value for actual use, e.g.: openssl rand -base64 48
SESSION_SECRET=replace-with-a-long-random-string

# Google OAuth (create credentials in Google Cloud Console; see oauth-setup skill)
# Authorized redirect URI for local dev: http://localhost:3000/auth/google/callback
# (the frontend's origin, not this API's — see FRONTEND_URL comment above)
GOOGLE_CLIENT_ID=replace-with-google-client-id
GOOGLE_CLIENT_SECRET=replace-with-google-client-secret

# MinIO (self-hosted object storage, matches docker-compose.yml; see APPROACH.md §8)
MINIO_ENDPOINT=localhost
MINIO_PORT=9000
MINIO_USE_SSL=false
MINIO_ACCESS_KEY=app
MINIO_SECRET_KEY=apppassword
MINIO_BUCKET=multi-purpose-uploads
# Public URL the browser loads uploaded files from — local dev only;
# production needs its own exposed route (see §8's last bullet).
MINIO_PUBLIC_URL=http://localhost:9000

# Assistant module (APPROACH.md §19) — one server-wide self-hosted
# freellmapi endpoint (OpenAI-compatible /v1/chat/completions), not a
# per-user API key. FREELLM_MODEL defaults to "auto" if unset.
FREELLM_API_URL=https://llmapi.example.tech/v1/chat/completions
FREELLM_API_KEY=replace-with-freellmapi-bearer-token
FREELLM_MODEL=auto

# Reminders module (APPROACH.md §21) — one server-wide Gmail sender account
# for digest emails. SMTP_APP_PASSWORD is a Gmail app password, not your
# normal account password (Google Account > Security > App passwords).
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=replace-with-sender-gmail-address
SMTP_APP_PASSWORD=replace-with-gmail-app-password

# Kafka event bus (APPROACH.md §22; matches docker-compose.yml's `kafka`
# service). Local dev (host-run API process) uses the published
# PLAINTEXT_HOST listener; the containerized api service (dev:all / prod)
# overrides this to the internal PLAINTEXT listener (kafka:19092) instead.
KAFKA_BROKERS=localhost:9092
KAFKA_CLIENT_ID=sovereign-api
